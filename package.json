{
  "name": "pomodoro-app",
  "version": "1.0.1",
  "description": "Une application Pomodoro minimaliste et élégante pour Windows",
  "main": "dist/main/main.js",
  "author": "Ronron",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "watch": "tsc -w",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.ronron.pomodoro",
    "productName": "Pomodoro",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "MondiaPupu.m4a",
      "cafe.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "cafe.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pomodoro"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.0"
  }
}
